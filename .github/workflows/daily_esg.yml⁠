name: Daily ESG News Archiver

on:
  schedule:
    # UTC 기준 06:00은 한국 시간(KST) 오후 3시(15:00)입니다.
    - cron: '0 6 * * *'
  workflow_dispatch: # 수동 실행 버튼 활성화 (테스트용)

permissions:
  contents: write # 저장소에 파일을 커밋하고 수정할 수 있는 권한 부여

jobs:
  collect-and-save:
    runs-on: ubuntu-latest

    steps:
      - name: 1. 저장소 코드 체크아웃
        uses: actions/checkout@v4

      - name: 2. Python 환경 설정
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: 3. 필수 라이브러리 설치
        run: |
          pip install -r requirements.txt

      - name: 4. ESG 뉴스 수집 스크립트 실행
        run: |
          python collector.py

      - name: 5. 결과 파일 자동 Commit 및 Push
        run: |
          git config --local user.email "github-actions[bot]@users.noreply.github.com"
          git config --local user.name "github-actions[bot]"
          git add esg_archive.md
          git diff --staged --quiet || git commit -m "docs: update ESG news archive ($(date +'%Y-%m-%d'))"
          git push
